PORT=5000
MONGODB_URI=YOUR_MONGODB_URI
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRE=7d

# Keep Razorpay values only if you want Razorpay as a fallback.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Select the live gateway used by POS4U.
PAYMENT_GATEWAY=getepay

# GetePay production credentials - fill these in Render/server environment only.
GETEPAY_MID=YOUR_GETEPAY_MID
GETEPAY_TERMINAL_ID=YOUR_GETEPAY_TERMINAL_ID
GETEPAY_KEY=YOUR_GETEPAY_KEY
GETEPAY_IV=YOUR_GETEPAY_IV
GETEPAY_URL=YOUR_GETEPAY_PRODUCTION_GENERATE_INVOICE_URL

# GetePay encryption is implemented exactly from the bank-provided React PG Kit.
# The encrypted req/res transport value is Base64. No encoding env variable is required.
GETEPAY_RETURN_URL=https://pos4u-backend.onrender.com/api/payment/getepay/return
GETEPAY_CALLBACK_URL=https://pos4u-backend.onrender.com/api/payment/getepay/callback

BACKEND_PUBLIC_URL=https://pos4u-backend.onrender.com
FRONTEND_URL=https://www.pos4you.co.in

GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_EMAIL=vermaavesh54@gmail.com
